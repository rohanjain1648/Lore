# FalkorDB (local docker compose defaults; for FalkorDB Cloud use its host/port/username/password)
FALKORDB_HOST=localhost
FALKORDB_PORT=6391
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# LLM providers. Groq is PRIMARY, OpenAI is the FALLBACK: every request goes to Groq first and moves to
# OpenAI on any error (rate limit, outage, bad tool call). Set either, both, or neither; with neither,
# Lore runs its deterministic offline agent and rule extractor (everything still works, answers are templated).
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_EXTRACT_MODEL=gpt-5.4-mini

# Optional: higher GitHub rate limit for the public-repo connector
GITHUB_TOKEN=

LORE_DEFAULT_TENANT=northwind
